# Copy to .env (repo root) and fill in. .env is gitignored. Never commit real values.

# --- shared ---
MONGODB_URI=
XAI_API_KEY=
NESSIE_API_KEY=
# Nessie answers over HTTPS only (http:// times out)
NESSIE_BASE_URL=https://api.nessieisreal.com
# Grok: OpenAI-compatible, https://api.x.ai/v1
GROK_MODEL=grok-4.3

# --- XRPL (Testnet only) ---
XRPL_WS=wss://s.altnet.rippletest.net:51233
# RLUSD Testnet issuer + currency hex (public values). Source:
# https://docs.ripple.com/products/stablecoin/developer-resources/rlusd-on-the-xrpl
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
RLUSD_CURRENCY_HEX=524C555344000000000000000000000000000000
# Testnet-scale limits in RLUSD (RLUSD supply on Testnet is ~27 RLUSD per faucet call; see docs/RISK_CHECKS.md)
AUTO_LIMIT=25
# Rolling 24h caps are read from the ledger, so dev test payments count too: keep headroom for the live demo.
DAILY_CAP=1000
PAYEE_DAILY_CAP=400
AGENT_SOURCE_TAG=26092026
# Phase 3: a payee wallet-change request freezes payments to that EIN for this long
HOLD_HOURS=72
# setup:xrpl top-up targets (RLUSD)
AGENT_RLUSD_TARGET=150
RLUSD_TREASURY_TARGET=250

# --- service URLs ---
API_URL=http://localhost:4000
XRPL_SERVICE_URL=http://localhost:4001
COSIGNER_URL=http://localhost:4002
# Phase 3: the officer (human approver) signer service; holds only OFFICER_SEED
OFFICER_URL=http://localhost:4004

# --- Phase 5: API (mongo mode) + live loop ---
# mongo | fixtures. Unset: mongo when MONGODB_URI is reachable at startup, else fixtures with a loud warning.
API_MODE=
# Shared secret for POST /events/payment (header x-events-token). The agent (xrpl/) sends it when NOTIFY_API=1.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVENTS_TOKEN=
# Agent processes (demo CLI, xrpl service) POST each decision to API_URL/events/payment (failures ignored)
NOTIFY_API=1
# Opt-in: when set, GET /subscribers needs header x-api-token (imessage/ must send it first). Leave empty until then.
SUBSCRIBERS_TOKEN=
# 1 = allow POST /dev/flip in mongo mode (it overwrites a real site's score; POST /dev/reset re-scores it)
DEV_ROUTES=
# 1 = POST /demo/:scenario requires externally started co-signer / xrpl service / officer (judged demo)
DEMO_NO_SPAWN=
# python used for data/risk.py and data/demo_reset.py (default: data/.venv interpreter for this OS)
PYTHON_BIN=
# Mongo mode: POST /demo/* and /dev/* (real Testnet runs, score resets) are accepted only from this machine. Browser
# origins on loopback (http://localhost:<port>, 127.0.0.1) always pass; list any other web origin here (comma-separated).
ALLOWED_ORIGINS=
# 1 = also accept POST /demo/* and /dev/* from other machines on the network (off by default)
DEMO_ALLOW_REMOTE=
# A real demo run that has not exited after this many ms releases the one-run lock (never killed). Default 600000.
RUN_LOCK_MAX_MS=

# --- signer seeds: NOT here. ---
# Each seed lives only in its own process's env file (all gitignored):
#   xrpl/.env.agent     AGENT_SEED=      (payment builder, weight 1)
#   xrpl/.env.cosigner  COSIGNER_SEED=   (compliance co-signer, weight 2)
#   xrpl/.env.officer   OFFICER_SEED=    (human officer, weight 1)
# Setup-only seeds (issuer, treasury, demo nonprofits, attacker) live in xrpl/.env.local.
