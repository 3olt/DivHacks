{
  "name": "divhacks",
  "private": true,
  "description": "NYC community services map + autonomous, ledger-guarded RLUSD payments on the XRP Ledger",
  "workspaces": [
    "api",
    "xrpl"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "start:api": "npm run start -w api",
    "smoke:api": "npm run smoke -w api",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w xrpl",
    "setup:xrpl": "npm run setup -w xrpl",
    "cosigner": "npm run cosigner -w xrpl",
    "demo": "npm run demo -w xrpl --",
    "seed:registry": "npm run seed-registry -w xrpl",
    "test:checks": "npm run test:checks -w xrpl",
    "redteam": "npm run redteam -w xrpl --",
    "reconcile": "npm run reconcile -w xrpl --",
    "onboard": "npm run onboard -w xrpl --",
    "xrpl:service": "npm run service -w xrpl",
    "officer:resolve": "npm run officer-resolve -w xrpl --",
    "officer:click": "npm run officer-click -w xrpl --",
    "officer": "npm run officer -w xrpl",
    "agent:revoke": "npm run agent-revoke -w xrpl --",
    "agent:restore": "npm run agent-restore -w xrpl --",
    "agent:status": "npm run agent-status -w xrpl --",
    "setup:escrow": "npm run setup-escrow -w xrpl"
  },
  "engines": {
    "node": ">=20"
  }
}
