# From the Photon dashboard (https://app.photon.codes) > Settings. Leave empty to run in dry-run mode (logs instead of sending).
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
PORT=4003
# Backend API (for "funded" alerts). Default: http://localhost:4000
API_URL=
# Grok (xAI) for "why?" replies. Get the key from the team; never commit it.
XAI_API_KEY=
GROK_MODEL=grok-4.3
# Grok budget guards (defaults shown)
GROK_DAILY_CAP=150
GROK_PER_PHONE_PER_HOUR=5
# Must match SUBSCRIBERS_TOKEN in the repo-root .env when the API requires it (sent as x-api-token)
SUBSCRIBERS_TOKEN=
